{
  "name": "@kloudlot/react-liveness",
  "version": "1.1.0",
  "description": "Headless React liveness check component using MediaPipe face detection",
  "keywords": [
    "liveness",
    "face-detection",
    "mediapipe",
    "react",
    "kyc",
    "identity-verification"
  ],
  "author": "Kazeem",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dev.json",
    "playground": "esbuild dev/calibrate.ts dev/demo.tsx --bundle --format=esm --jsx=automatic --outdir=dev --servedir=dev --serve=127.0.0.1:8000",
    "calibrate": "npm run playground",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": ">=0.10.35",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kloudlot/react-liveness.git"
  },
  "dependencies": {
    "lucide-react": "^1.21.0"
  }
}
