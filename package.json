{
  "name": "@kloudlot/react-liveness",
  "version": "1.0.1",
  "description": "Headless React liveness check component using MediaPipe face detection",
  "keywords": ["liveness", "face-detection", "mediapipe", "react", "kyc", "identity-verification"],
  "author": "Kazeem",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --external react-dom --external @mediapipe/tasks-vision",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-dom --external @mediapipe/tasks-vision",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": ">=0.10.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kloudlot/react-liveness"
  }
}
